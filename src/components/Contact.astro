---
// Contact section — information and map
const { headline, subheadline, whatsapp_cta, phone, email, address, hours, whatsappLink } = Astro.props;
---

<section id="contact" class="py-section-gap px-margin-mobile md:px-margin-desktop bg-surface-container">
  <div class="max-w-container-max mx-auto">
    <div class="text-center mb-12">
      <h2 class="font-display text-4xl md:text-5xl text-on-surface mb-4">{headline}</h2>
      <div class="w-16 h-1 bg-primary-container mx-auto mb-6"></div>
      <p class="font-body text-lg text-on-surface-variant max-w-2xl mx-auto">{subheadline}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Contact details -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-primary text-lg">phone</span>
          </div>
          <div>
            <p class="font-body text-xs font-bold uppercase tracking-widest text-secondary mb-1">TELEFON</p>
            <a href={`tel:${phone}`} class="font-body text-sm font-medium text-on-surface hover:text-primary transition-colors">{phone}</a>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-primary text-lg">mail</span>
          </div>
          <div>
            <p class="font-body text-xs font-bold uppercase tracking-widest text-secondary mb-1">E-MAIL</p>
            <a href={`mailto:${email}`} class="font-body text-sm font-medium text-on-surface hover:text-primary transition-colors">{email}</a>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-primary text-lg">location_on</span>
          </div>
          <div>
            <p class="font-body text-xs font-bold uppercase tracking-widest text-secondary mb-1">ADRESSE</p>
            <p class="font-body text-sm font-medium text-on-surface">{address}</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-primary text-lg">schedule</span>
          </div>
          <div>
            <p class="font-body text-xs font-bold uppercase tracking-widest text-secondary mb-1">ÖFFNUNGSZEITEN</p>
            <p class="font-body text-sm font-medium text-on-surface">{hours}</p>
          </div>
        </div>
      </div>

      <!-- Map section - Adjusted height for better balance -->
      <div class="relative w-full h-[320px] rounded-2xl overflow-hidden border border-outline-variant/20 shadow-sm group">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2414.442186743228!2d13.413345!3d52.5160075!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a84f00565d3619%3A0x77bece6baef0f997!2zS09IQU5B kimchi%C3%84sthetik%20%26%20Sch%C3%B6nheit!5e0!3m2!1sde!2sde!4v1724150000000!5m2!1sde!2sde" 
          class="absolute inset-0 w-full h-full border-0" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
        <div class="absolute bottom-4 right-4">
          <a 
            href="https://maps.app.goo.gl/Mk9ZmzYgAYzuGxSA6" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-white text-on-surface font-body text-xs font-bold px-4 py-2 rounded-full shadow-lg hover:bg-surface-container transition-colors inline-flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-sm">directions</span>
            Google Maps
          </a>
        </div>
      </div>
    </div>

    <div class="mt-16 text-center">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-primary text-on-primary font-body text-base font-bold uppercase tracking-widest px-10 py-5 rounded-full hover:opacity-90 transition-all duration-300 btn-primary-shadow"
      >
        <span class="material-symbols-outlined text-xl">chat</span>
        {whatsapp_cta}
      </a>
      <div class="mt-8">
        <a
          href="https://www.instagram.com/kohana_studio_berlin/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#E1306C] text-white font-body text-sm font-bold uppercase tracking-wide px-8 py-4 rounded-full hover:opacity-90 transition-all duration-300 shadow-md"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Folgen Sie uns auf Instagram
        </a>
      </div>
    </div>
  </div>
</section>
