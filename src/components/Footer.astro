---
// Footer — legal links + copyright
const { privacy, imprint, copyright, lang = "de" } = Astro.props;
---

<footer class="bg-surface-container border-t border-outline-variant/20 pt-16 pb-12">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="flex flex-col items-center gap-8">
      <!-- Brand -->
      <a href="/" class="font-display text-3xl text-primary tracking-tight">Kohana Studio</a>

      <!-- Legal nav -->
      <nav class="flex flex-wrap justify-center gap-6">
        <a
          href={`/${lang}/privacy`}
          class="font-body text-sm text-secondary hover:text-primary transition-colors"
        >
          {privacy}
        </a>
        <a
          href={`/${lang}/imprint`}
          class="font-body text-sm text-secondary hover:text-primary transition-colors"
        >
          {imprint}
        </a>
        <a
          href="https://www.instagram.com/kohana_studio_berlin/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-sm text-secondary hover:text-primary transition-colors"
        >
          Instagram
        </a>
      </nav>

      <!-- Copyright -->
      <p class="font-body text-sm text-on-surface-variant opacity-70">{copyright.replace('2024', '2026')}</p>
    </div>
  </div>
</footer>
