---
// Hero section — video background with image slideshow fallback
const { eyebrow, headline, subheadline, cta_primary, cta_secondary, whatsappLink } = Astro.props;

const heroImages = [
  "/images/hero-bg.jpg",
  "/images/hero-2.jpg",
  "/images/hero-3.jpg",
  "/images/hero-4.jpg",
];
---

<section class="relative min-h-[90vh] flex items-center pt-20">
  <!-- Video Background -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/videos/poster-0.jpg"
      class="w-full h-full object-cover"
      aria-hidden="true"
    >
      <source src="/videos/studio-tour.mp4" type="video/mp4">
      <source src="/videos/studio-tour.webm" type="video/webm">
    </video>
    <!-- Warm gradient overlay: left-heavy so text stays readable -->
    <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/85 to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop w-full">
    <div class="max-w-2xl">
      <p class="font-body text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">
        {eyebrow}
      </p>
      <h1 class="font-display text-4xl md:text-6xl lg:text-7xl text-on-surface leading-[1.1] mb-8">
        {headline}
      </h1>
      <p class="font-body text-base md:text-lg text-on-surface-variant leading-[1.75] max-w-md mb-10">
        {subheadline}
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-primary text-on-primary font-body text-sm font-bold uppercase tracking-wide px-8 py-4 rounded-lg hover:opacity-90 transition-all duration-300 btn-primary-shadow inline-flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-base">chat</span>
          {cta_primary}
        </a>
        <a
          href="#portfolio"
          class="border border-outline text-on-surface font-body text-sm font-bold uppercase tracking-wide px-8 py-4 rounded-lg hover:bg-surface-container-high transition-all duration-300 inline-flex items-center gap-2"
        >
          {cta_secondary}
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>
