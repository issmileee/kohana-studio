---
// Portfolio — "Kunst im Detail"
// Mobile: grouped per category with sticky headers + stacked cards (same model as Services)
// Desktop: filter pills + responsive grid (client-side filtering)
const { headline, subheadline, filters, items } = Astro.props;

// Group items following the localized `filters` order from the language JSON
const groups = filters
  .map((filter) => ({ filter, items: items.filter((i) => i.category === filter) }))
  .filter((g) => g.items.length > 0);
---

<style>
  /* Sticky category header (mobile only) — sits right below the fixed site nav */
  .pf-cat-header {
    position: sticky;
    top: 76px;
    z-index: 20;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    padding-block: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-outline-variant) 30%, transparent);
  }

  /* Stacking cards (mobile only) */
  .pf-stack-card {
    position: sticky;
    top: var(--stack-top);
  }
  .pf-stack-card + .pf-stack-card {
    margin-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .pf-cat-header {
      position: static;
      background: transparent;
      backdrop-filter: none;
      border-bottom: none;
      padding-block: 0;
    }
    .pf-stack-card {
      position: static;
    }
    .pf-stack-card + .pf-stack-card {
      margin-top: 0;
    }
  }
</style>

<section id="portfolio" class="py-section-gap px-margin-mobile md:px-margin-desktop">
  <div class="max-w-container-max mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="font-display text-4xl md:text-5xl text-on-surface mb-4">{headline}</h2>
      <p class="font-body text-lg text-on-surface-variant max-w-2xl mx-auto">{subheadline}</p>
    </div>

    <!-- ══════════════ MOBILE: grouped stacks (Leistungen model) ══════════════ -->
    <div class="md:hidden">
      {groups.map((group, gi) => (
        <div class:list={["mb-14", gi === 0 && "-mt-2"]}>
          <!-- Sticky category header -->
          <div class="pf-cat-header">
            <p class="font-body text-xs font-bold uppercase tracking-widest text-primary">
              {String(gi + 1).padStart(2, "0")}
            </p>
            <h3 class="font-display text-2xl text-on-surface">{group.filter}</h3>
          </div>

          <!-- Stacked cards -->
          <div class="flex flex-col pt-5">
            {group.items.map((item, idx) => (
              <div
                class="pf-stack-card bg-surface-container-lowest rounded-xl overflow-hidden border border-outline-variant/20 shadow-md"
                style={`--stack-top: ${112 + idx * 14}px`}
              >
                <div class="aspect-[4/3] overflow-hidden bg-surface-container/40 flex items-center justify-center p-1">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-contain md:object-cover rounded-lg"
                    loading="lazy"
                  />
                </div>
                <div class="p-4 flex items-start justify-between gap-3">
                  <div>
                    <p class="font-body text-[10px] font-bold uppercase tracking-widest text-secondary mb-0.5">
                      {item.category}
                    </p>
                    <h4 class="font-display text-base text-on-surface leading-tight">{item.title}</h4>
                    {item.subtitle && (
                      <p class="font-body text-xs text-on-surface-variant mt-1">{item.subtitle}</p>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ══════════════ DESKTOP: filter pills + grid ══════════════ -->
    <div class="hidden md:block">
      <!-- Filter tabs -->
      <div class="flex flex-wrap justify-center gap-4 mb-12" id="portfolio-filters">
        {filters.map((filter, i) => (
          <button
            type="button"
            data-filter={filter}
            class={`pf-pill font-body text-sm font-bold uppercase tracking-widest px-6 py-2 rounded-full border transition-all duration-300 ${
              i === 0
                ? "bg-primary text-on-primary border-primary"
                : "bg-transparent text-secondary border-outline hover:border-primary hover:text-primary"
            }`}
          >
            {filter}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
        {items.map((item) => (
          <div
            class="portfolio-item group relative rounded-xl overflow-hidden border border-outline-variant/20 shadow-sm bg-surface-container/20"
            data-category={item.category}
          >
            <div class="aspect-square overflow-hidden flex items-center justify-center p-2">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-contain group-hover:scale-102 transition-transform duration-500 rounded-lg"
                loading="lazy"
              />
            </div>
            <!-- Overlay label -->
            <div class="absolute bottom-0 left-0 right-0 bg-surface-container-lowest/95 backdrop-blur p-4 border-t border-outline-variant/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
              <p class="font-body text-xs font-bold uppercase tracking-widest text-primary mb-1">
                {item.category}
              </p>
              <h4 class="font-display text-lg text-on-surface">{item.title}</h4>
              <p class="font-body text-xs text-on-surface-variant mt-1">{item.subtitle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Desktop filter logic — scoped to the desktop grid only,
  // so the mobile stacked view is never touched.
  const pills = document.querySelectorAll<HTMLButtonElement>("#portfolio-filters [data-filter]");
  const gridItems = document.querySelectorAll<HTMLElement>("#portfolio-grid .portfolio-item");

  const ACTIVE = ["bg-primary", "text-on-primary", "border-primary"];
  const IDLE = ["bg-transparent", "text-secondary", "border-outline"];

  function applyFilter(filter: string | undefined) {
    if (!filter) return;
    pills.forEach((b) => {
      b.classList.remove(...ACTIVE, ...IDLE);
      b.classList.add(...(b.dataset.filter === filter ? ACTIVE : IDLE));
    });
    gridItems.forEach((el) => {
      const show = el.dataset.category === filter;
      el.style.opacity = show ? "1" : "0";
      setTimeout(() => (el.style.display = show ? "" : "none"), show ? 0 : 250);
    });
  }

  pills.forEach((btn) => btn.addEventListener("click", () => applyFilter(btn.dataset.filter)));

  // Initial state: first category selected
  applyFilter(pills[0]?.dataset.filter);
</script>
