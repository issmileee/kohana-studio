---
// Trust bar — certification, hygiene, premium care badges
const { items } = Astro.props;
---

<section class="bg-surface-container-low py-12 border-y border-outline-variant/15">
  <div
    class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex flex-wrap justify-center gap-8 md:gap-16"
  >
    {items.map((item) => (
      <div class="flex flex-col md:flex-row items-center gap-3 text-center md:text-left">
        <div class="w-10 h-10 rounded-full bg-primary-container/15 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-primary text-xl">{item.icon}</span>
        </div>
        <span class="font-body text-xs font-bold uppercase tracking-[0.15em] text-on-surface leading-tight">
          {item.label}
        </span>
      </div>
    ))}
  </div>
</section>
