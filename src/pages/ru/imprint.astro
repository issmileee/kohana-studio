---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import content from "../../content/ru.json";

const langs = [
  { code: "de", label: "DE", href: "/de" },
  { code: "uk", label: "UK", href: "/uk" },
  { code: "ru", label: "RU", href: "/ru" },
  { code: "en", label: "EN", href: "/en" },
];

const whatsappLink = `https://wa.me/${content.whatsapp.number}?text=${encodeURIComponent(content.whatsapp.message)}`;
---

<BaseLayout
  lang="ru"
  site={{
    title: "Выходные данные | Kohana Studio",
    description: "Выходные данные KOHANA Ästhetik & Schönheit, Анна Кохут.",
    keywords: content.site.keywords,
  }}
  langs={langs}
  currentLang="ru"
  whatsappLink={whatsappLink}
  whatsappLabel="Записаться"
>
  <Header nav={content.nav} langs={langs} currentLang="ru" bookLabel={content.nav.book} whatsappLink={whatsappLink} />

  <main class="pt-20">
    <section class="py-section-gap px-margin-mobile md:px-margin-desktop">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-display text-4xl md:text-5xl text-on-surface mb-10">Выходные данные</h1>

        <p class="font-body text-on-surface-variant leading-relaxed mb-6">
          Ответственная за содержание данного сайта согласно § 5 TMG (Закон о телемедиа Германии):
        </p>

        <p class="font-body text-on-surface leading-relaxed mb-6">
          Анна Кохут<br />
          KOHANA Ästhetik &amp; Schönheit<br />
          Waisenstraße 1<br />
          10179 Берлин<br />
          Германия
        </p>

        <p class="font-body text-on-surface leading-relaxed mb-6">
          Телефон: <a href="tel:+4915159076188" class="text-primary hover:underline">+49 151 5907 6188</a><br />
          Эл. почта: <a href="mailto:anna.kohut.19901@gmail.com" class="text-primary hover:underline">anna.kohut.19901@gmail.com</a><br />
          Instagram: <a href="https://www.instagram.com/kohana_studio_berlin/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">@kohana_studio_berlin</a>
        </p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Надзорный орган</h2>
        <p class="font-body text-on-surface-variant leading-relaxed mb-6">
          Bezirksamt Pankow von Berlin – Ordnungsamt (Районное управление Панков г. Берлина – Управление по делам порядка)<br />
          Fröbelstr. 17, Haus 6, 10405 Berlin
        </p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Идентификационный номер плательщика НДС</h2>
        <p class="font-body text-on-surface-variant leading-relaxed mb-6">– не указан –</p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Профессиональная квалификация</h2>
        <p class="font-body text-on-surface-variant leading-relaxed mb-6">
          Косметолог / мастер перманентного макияжа<br />
          Присвоена в: Германии
        </p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Отказ от ответственности</h2>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Несмотря на тщательный контроль содержания, мы не несём ответственности за содержание внешних ссылок. За содержание связанных страниц несут ответственность исключительно их владельцы.
        </p>
      </div>
    </section>
  </main>

  <Footer privacy={content.footer.privacy} imprint={content.footer.imprint} copyright={content.footer.copyright} lang="ru" />
</BaseLayout>
