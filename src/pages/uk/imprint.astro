---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import content from "../../content/uk.json";

const langs = [
  { code: "de", label: "DE", href: "/de" },
  { code: "uk", label: "UK", href: "/uk" },
  { code: "ru", label: "RU", href: "/ru" },
  { code: "en", label: "EN", href: "/en" },
];

const whatsappLink = `https://wa.me/${content.whatsapp.number}?text=${encodeURIComponent(content.whatsapp.message)}`;
---

<BaseLayout
  lang="uk"
  site={{
    title: "Вихідні дані | Kohana Studio",
    description: "Вихідні дані KOHANA Ästhetik & Schönheit, Анна Кохут.",
    keywords: content.site.keywords,
  }}
  langs={langs}
  currentLang="uk"
  whatsappLink={whatsappLink}
  whatsappLabel="Записатися"
>
  <Header nav={content.nav} langs={langs} currentLang="uk" bookLabel={content.nav.book} whatsappLink={whatsappLink} />

  <main class="pt-20">
    <section class="py-section-gap px-margin-mobile md:px-margin-desktop">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-display text-4xl md:text-5xl text-on-surface mb-10">Вихідні дані</h1>

        <p class="font-body text-on-surface-variant leading-relaxed mb-6">
          Відповідальна за зміст цього сайту згідно § 5 TMG (Закон про телемедіа Німеччини):
        </p>

        <p class="font-body text-on-surface leading-relaxed mb-6">
          Анна Кохут<br />
          KOHANA Ästhetik &amp; Schönheit<br />
          Waisenstraße 1<br />
          10179 Берлін<br />
          Німеччина
        </p>

        <p class="font-body text-on-surface leading-relaxed mb-6">
          Телефон: <a href="tel:+4915159076188" class="text-primary hover:underline">+49 151 5907 6188</a><br />
          Ел. пошта: <a href="mailto:anna.kohut.19901@gmail.com" class="text-primary hover:underline">anna.kohut.19901@gmail.com</a><br />
          Instagram: <a href="https://www.instagram.com/kohana_studio_berlin/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">@kohana_studio_berlin</a>
        </p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Наглядовий орган</h2>
        <p class="font-body text-on-surface-variant leading-relaxed mb-6">
          Bezirksamt Pankow von Berlin – Ordnungsamt (Районне управління Панков м. Берліна – Управління порядку)<br />
          Fröbelstr. 17, Haus 6, 10405 Berlin
        </p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Ідентифікаційний номер платника ПДВ</h2>
        <p class="font-body text-on-surface-variant leading-relaxed mb-6">– не вказано –</p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Професійна кваліфікація</h2>
        <p class="font-body text-on-surface-variant leading-relaxed mb-6">
          Косметолог / майстер перманентного макіяжу<br />
          Присвоєна в: Німеччині
        </p>

        <h2 class="font-display text-2xl text-on-surface mt-10 mb-3">Відмова від відповідальності</h2>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Незважаючи на ретельний контроль змісту, ми не несемо відповідальності за зміст зовнішніх посилань. За зміст пов'язаних сторінок відповідають виключно їхні власники.
        </p>
      </div>
    </section>
  </main>

  <Footer privacy={content.footer.privacy} imprint={content.footer.imprint} copyright={content.footer.copyright} lang="uk" />
</BaseLayout>
